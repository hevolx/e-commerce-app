<%- include('../partials/header') %>

<h1>Your cart</h1>

<% if (carts.length === 0) { %>
  <p>Your cart is empty. <a href="/">Browse products</a></p>
<% } %>

<ul data-testid="cart-page">
  <% carts.forEach(function(cart) { %>
    <li class="row">
      <span>
        <a href="/product/<%= cart.productid %>"><%= cart.name %></a>
        <span class="muted">&times; <%= cart.qty %></span>
      </span>
      <span class="row-actions">
        <%= formatPrice(cart.qty * cart.price) %>
        <form method="POST" action="/cart/<%= cartId %>/items/<%= cart.id %>/delete" data-testid="cart-remove-form">
          <input type="submit" class="secondary" value="Remove">
        </form>
      </span>
    </li>
    <% }); %>
</ul>

<% if (carts.length > 0) { %>
  <p class="total">Total: <%= formatPrice(total) %></p>
  <p><a class="button" href="/carts/<%= cartId %>/checkout">Go to checkout</a></p>
<% } %>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<p><a href="/order-history">&larr; Order history</a></p>

<section data-testid="order-detail">
  <h1>Order #<%= order.id %></h1>
  <ul>
    <% items.forEach(function(item) { %>
      <li class="row">
        <span>
          <%= item.name %>
          <span class="muted">&times; <span data-testid="order-item-qty"><%= item.qty %></span></span>
        </span>
        <span><%= formatPrice(item.qty * item.price) %></span>
      </li>
      <% }); %>
  </ul>

  <p class="total">Total: <span data-testid="order-total"><%= order.total %></span> kr</p>
</section>

<%- include('../partials/footer') %>
